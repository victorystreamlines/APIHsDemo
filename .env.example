# User Management System Environment Configuration
# Copy this file to .env and update the values as needed

# Application Settings
APP_NAME="User Management System"
DEBUG=false
VERSION="1.0.0"

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Security Settings
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Configuration
DATABASE_URL=sqlite:///./users.db
DATABASE_ECHO=false

# CORS Settings (comma-separated list of allowed origins)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://localhost:3000,https://localhost:8080

# API Configuration
API_V1_PREFIX=/api/v1

# Logging
LOG_LEVEL=INFO

# Production Settings (uncomment for production)
# SECRET_KEY=generate-a-strong-random-secret-key-for-production
# DEBUG=false
# DATABASE_URL=sqlite:///./data/users.db
# LOG_LEVEL=WARNING
# BACKEND_CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com